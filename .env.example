APP_NAME="GOAT - Social Debate Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
CSP_ENABLED=true

DB_CONNECTION=mysql
DB_HOST=127.0.1.28
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# MySQL root, only read when the data volume is first created; falls back to DB_PASSWORD
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CACHE_STORE=database
CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
RESPONSE_CACHE_DRIVER=file

REDIS_CLIENT=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

PUID=1000
PGID=1000

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://127.0.0.1:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GEMINI_API_KEY=

# Firebase Cloud Messaging (mobile push). Leave blank to disable push (DB
# notifications still work). FCM_CREDENTIALS = path to the service-account JSON.
FCM_PROJECT_ID=
FCM_CREDENTIALS=storage/app/service-account.json

# Content moderation.
# TEXT moderation + post context/tag generation -> DeepSeek (OpenAI-compatible).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# IMAGE moderation -> Groq vision (DeepSeek has no vision model). Optional;
# if unset, images are validated for type/size but not AI-moderated.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Shared moderation prompts (reused by DeepSeek for text; Groq for image).
# prompts are NOT in git. Either deploy resources/prompts/moderation/{text,comment,url,image}.txt
# or set the GROQ_PROMPT_* values below (env wins over the files)
GROQ_PROMPT_TEXT=
GROQ_PROMPT_URL=
GROQ_PROMPT_COMMENT=
GROQ_PROMPT_IMAGE=
GROQ_MASTER_PROMPT=

# true = block content when moderation is down (API error, bad key)
MODERATION_FAIL_CLOSED=false

GEMINI_BANNED_WORDS_UZ=

GEMINI_MODERATION_PROMPT=
GEMINI_IMAGE_MODERATION_PROMPT=
GEMINI_URL_MODERATION_PROMPT=
GEMINI_USE_JSON_MODE=true
GEMINI_CONTEXT_GENERATION_PROMPT=
GEMINI_TAG_GENERATION_PROMPT=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_AI_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
CLOUDFLARE_AI_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

ADMIN_USER_ID=


TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

X_API_KEY=
X_API_SECRET_KEY=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"


BROADCAST_DRIVER=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=
PUSHER_APP_ENCRYPTED=true

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https
VITE_PUSHER_APP_ENCRYPTED=true

GITHUB_API_TOKEN=
NODE_AUTH_TOKEN=

# --- security ---
# argon2id; HASH_VERIFY=false lets existing bcrypt hashes log in and upgrade on the spot
HASH_DRIVER=argon2id
HASH_VERIFY=false
PASSWORD_MIN_LENGTH=10
# haveibeenpwned k-anonymity check, on by default in production
PASSWORD_CHECK_BREACHED=true
# comma separated, https only in production
CORS_ALLOWED_ORIGINS=https://www.goat.uz,https://goat.uz
# extra hosts besides APP_URL's
TRUSTED_HOSTS=
# seconds a rotated refresh token is still accepted
REFRESH_GRACE_SECONDS=10
API_ACCESS_TOKEN_MINUTES=15
SANCTUM_TOKEN_PREFIX=goat_
# SonarCloud webhook HMAC secret, requests without a valid signature are rejected
SONAR_WEBHOOK_SECRET=
# redirect URIs the mobile app may use for the X code exchange, comma separated
X_MOBILE_REDIRECT_URIS=
