:80 {
    handle /up {
                   respond "Health OK" 200
               }
    handle {
               redir https://www.goat.uz{uri} permanent
           }
}

goat.uz {
    redir https://www.goat.uz{uri} permanent
}

www.goat.uz {
    tls /etc/caddy/certs/goat.uz.pem /etc/caddy/certs/goat.uz.key {
                                                                      protocols tls1.2 tls1.3
                                                                  }
    # defaults for what PHP does not answer (static files, uploads); ? = only when the app did not already set it
    header {
        ?X-Frame-Options "SAMEORIGIN"
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
        ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"
        ?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
        -X-Powered-By
        defer
    }

    # JSON access log; secrets in cookies, auth headers and URLs never reach the log
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>X-Xsrf-Token delete
                request>headers>Referer regexp `(?i)(/reset-password/|/notifications/unsubscribe/|/email/verify/\d+/|[?&](?:token|code|state|signature|hash|id_token|access_token|refresh_token|oauth_token|oauth_verifier|password|auth_date)=)[^/?&\s"]+` `${1}REDACTED`
                request>uri regexp `(?i)(/reset-password/|/notifications/unsubscribe/|/email/verify/\d+/|[?&](?:token|code|state|signature|hash|id_token|access_token|refresh_token|oauth_token|oauth_verifier|password|auth_date)=)[^/?&\s"]+` `${1}REDACTED`
                resp_headers>Set-Cookie delete
            }
        }
    }

#    @emptyQuery {
#                    query ""
#                }
#    uri @emptyQuery strip_suffix ?
    @trailingQuestion {
                          expression "{uri}.endsWith('?')"
                      }
    redir @trailingQuestion {path} 301

# MAINTENANCE MODE: START
#    respond `
#         System Maintenance
#            Assalomu alaykum! We are currently performing a scheduled upgrade to improve your experience.
#            We truly appreciate your patience and promise to be back online shortly with a faster, smoother platform.
#
#         Goat.uz
#    ` 503
# MAINTENANCE MODE: END

# NORMAL MODE

    root * /app/public
    encode zstd gzip

    php_server {
                   resolve_root_symlink
               }

    @hidden {
                path */.*
            }
    respond @hidden 403

    # /storage is user uploads: images only, never an archive, dump or log
    @storageNonImage {
        path /storage/*
        not path *.webp *.jpg *.jpeg *.png *.gif *.avif
    }
    respond @storageNonImage 404

    @static {
                file
                path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.wasm
            }
    header @static Cache-Control "max-age=31536000"

    file_server
}

git.goat.uz {
    tls /etc/caddy/certs/goat.uz.pem /etc/caddy/certs/goat.uz.key
    redir https://github.com/umaarov/goat-dev permanent
}

docs.goat.uz {
    tls /etc/caddy/certs/goat.uz.pem /etc/caddy/certs/goat.uz.key
    root * /app/docs
    rewrite / goat_doc_en.pdf
    file_server
    header {
               Content-Type "application/pdf"
               Content-Disposition "inline"
           }
}

# internal only (not published): Prometheus scrapes it over the docker network
:2020 {
    metrics
}
