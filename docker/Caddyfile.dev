:80 {
    root * /app/public
    encode zstd gzip

    php_server {
                   resolve_root_symlink
               }

    # /storage is user uploads: images only
    @storageNonImage {
        path /storage/*
        not path *.webp *.jpg *.jpeg *.png *.gif *.avif
    }
    respond @storageNonImage 404

    try_files {path} {path}/ /index.php?{query}
    file_server

    header {
               Cache-Control "no-cache, no-store, must-revalidate"
           }

    handle /up {
                   respond "Health OK" 200
               }
}
